rules_version = '2';
// Regole per MenuCasa: ogni famiglia è un documento il cui id è il codice famiglia
// (lungo e casuale). Chi non conosce il codice non può leggere né elencare nulla.
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{code} {
      // solo get, mai list: impedisce di elencare i codici delle famiglie
      allow get, create, update: if request.auth != null && code.size() >= 14;

      match /{sub}/{id} {
        allow read, write: if request.auth != null && code.size() >= 14;
      }
    }
  }
}
